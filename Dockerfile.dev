FROM php:8.4-cli-trixie

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        unzip \
        libzip-dev \
    && docker-php-ext-install pdo_mysql zip bcmath pcntl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 8000

# Install into the vendor volume after Compose mounts the project.
CMD ["sh", "-c", "composer install --no-interaction --prefer-dist && composer check-platform-reqs && exec php artisan serve --host=0.0.0.0 --port=8000"]
