# Identificação da aplicação e endereço do proxy no computador.
APP_NAME=TicoGames
APP_ENV=local
# Gere com php artisan key:generate --show e salve no .env da raiz; veja README.md.
APP_KEY=
# Exibe detalhes dos erros durante o desenvolvimento local.
APP_DEBUG=true
APP_URL=http://localhost

# Idioma da aplicação e dos dados fictícios usados futuramente nos testes.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Mantém o controle de manutenção em arquivo, sem depender de tabelas.
APP_MAINTENANCE_DRIVER=file

# Grava erros e mensagens em storage/logs/laravel.log.
LOG_CHANNEL=single
LOG_LEVEL=debug

# Dentro do Docker, mysql é o nome do serviço do banco no Compose.
# Estas credenciais são apenas para o ambiente local de desenvolvimento.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ticogames
DB_USERNAME=ticogames
DB_PASSWORD=ticogames
MYSQL_ROOT_PASSWORD=rootpassword

# Salva sessões em arquivos; não exige a tabela sessions nesta etapa.
SESSION_DRIVER=file
# Tempo de inatividade da sessão, em minutos.
SESSION_LIFETIME=120

# Salva o cache em arquivos, sem Redis ou tabela de cache.
CACHE_STORE=file

# Executa tarefas na própria requisição, sem processo de fila separado.
QUEUE_CONNECTION=sync

# Guarda arquivos localmente; não precisamos de armazenamento em nuvem.
FILESYSTEM_DISK=local

# Registra emails e eventos no log, sem serviços externos.
MAIL_MAILER=log
BROADCAST_CONNECTION=log

# O proxy entrega o Vue e a API na mesma origem. O Sanctum usa host e porta.
FRONTEND_URL=http://localhost
API_BASE_URL=
SANCTUM_STATEFUL_DOMAINS=localhost
# HTTP local; em produção com HTTPS, usar true.
SESSION_SECURE_COOKIE=false
